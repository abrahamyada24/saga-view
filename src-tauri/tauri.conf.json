{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "saga-view",
  "version": "0.1.0",
  "identifier": "com.sagaview.app",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "Saga View",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/node"
    ],
    "resources": [
      ".output"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
